package client2 ;

import common.Message ;
import common.MessageType ;

import java.io.ObjectInputStream ;
import java.io.ObjectOutputStream ;
import java.net.Socket ;

public class Client2 {

    private static final String HOST = "127.0.0.1" ;
    private static final int PORT = 5000 ;

    public static void main(String[] args) {

        // try-with-resources bloğu, bağlantı bitince soketleri otomatik kapatır
        try (Socket socket = new Socket(HOST, PORT) ;

             ObjectOutputStream out = new ObjectOutputStream(socket.getOutputStream()) ;
             ObjectInputStream in = new ObjectInputStream(socket.getInputStream()))
             
        {

            System.out.println("[BAĞLANDI] Sunucuya " + HOST + ":" + PORT + " üzerinden bağlanıldı.");

            // Sunucuya register mesajı gönder
            Message registerMsg = new Message(MessageType.REGISTER, "Client1") ;
            out.writeObject(registerMsg) ;
            out.flush() ; // Bufferı zorla boşaltarak anında gönder

            // Sunucudan gelen cevabı dinle
            Message response = (Message) in.readObject() ;
            System.out.println("[SUNUCU CEVABI] Tip: " + response.type() + " | İçerik: " + response.payload()) ;

            // TODO: İstemci burada dinlemeye devam edecek veya kullanıcıdan input alacak bir thread başlatılmalı

        }
        catch (Exception e) {

            System.out.println("[HATA] Sunucuya bağlanılamadı: " + e.getMessage()) ;

        }

    }

}